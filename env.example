# Isi key yang kamu punya saja. Provider tanpa key otomatis dilewati.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
REQUESTY_API_KEY=
AION_API_KEY=
TAVILY_API_KEY=

# Opsional: fitur AI menyiapkan perubahan lalu membuat branch + Pull Request setelah disetujui.
# Fine-grained token: Contents (read/write), Pull requests (read/write), Metadata (read).
GITHUB_TOKEN= 
GITHUB_REPOSITORY=amperaofficial26-beep

# Opsional: jatah BUILD disimpan di Supabase (tabel build_limits, lihat README untuk SQL-nya).
# Tanpa dua baris ini, jatah jatuh ke memori proses dan tidak bertahan setelah server dimuat ulang.
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # alternatif bila memakai service role (jangan commit key asli)
# BUILD_LIMITS_TABLE=build_limits
# BUILD_PROJECTS_TABLE=build_projects   # snapshot status node/proyek BUILD
# BUILD_LIMIT_PER_WINDOW=10    # jumlah maksimum BUILD per jendela 3 hari (default 10)

# xKiro (base URL default sudah https://api.xkiro.com/v1)
XKIRO_API_KEY=
# XKIRO_MODEL=openai/gpt-5.6-sol   # format wajib vendor/model

# Opsional: ganti model default per provider
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# REQUESTY_MODEL=openai/gpt-4o-mini
# AION_MODEL=aion-1.0-mini
